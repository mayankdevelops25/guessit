# Firebase Web Config — Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=guess-of-the-day-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=guess-of-the-day-demo
VITE_FIREBASE_STORAGE_BUCKET=guess-of-the-day-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO0000

# API base — defaults to same-origin /api (Cloudflare Pages Functions)
# VITE_API_BASE_URL=https://guessofday.pages.dev

# Anonymous session: no env needed — auto-mints via POST /api/session (X-Session-Id)
# Future upgrade: Firebase Auth anonymous → permanent (see docs/ARCHITECTURE.md)

# Cloudflare Turnstile (fast-follow if bot abuse on /api/chip)
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
